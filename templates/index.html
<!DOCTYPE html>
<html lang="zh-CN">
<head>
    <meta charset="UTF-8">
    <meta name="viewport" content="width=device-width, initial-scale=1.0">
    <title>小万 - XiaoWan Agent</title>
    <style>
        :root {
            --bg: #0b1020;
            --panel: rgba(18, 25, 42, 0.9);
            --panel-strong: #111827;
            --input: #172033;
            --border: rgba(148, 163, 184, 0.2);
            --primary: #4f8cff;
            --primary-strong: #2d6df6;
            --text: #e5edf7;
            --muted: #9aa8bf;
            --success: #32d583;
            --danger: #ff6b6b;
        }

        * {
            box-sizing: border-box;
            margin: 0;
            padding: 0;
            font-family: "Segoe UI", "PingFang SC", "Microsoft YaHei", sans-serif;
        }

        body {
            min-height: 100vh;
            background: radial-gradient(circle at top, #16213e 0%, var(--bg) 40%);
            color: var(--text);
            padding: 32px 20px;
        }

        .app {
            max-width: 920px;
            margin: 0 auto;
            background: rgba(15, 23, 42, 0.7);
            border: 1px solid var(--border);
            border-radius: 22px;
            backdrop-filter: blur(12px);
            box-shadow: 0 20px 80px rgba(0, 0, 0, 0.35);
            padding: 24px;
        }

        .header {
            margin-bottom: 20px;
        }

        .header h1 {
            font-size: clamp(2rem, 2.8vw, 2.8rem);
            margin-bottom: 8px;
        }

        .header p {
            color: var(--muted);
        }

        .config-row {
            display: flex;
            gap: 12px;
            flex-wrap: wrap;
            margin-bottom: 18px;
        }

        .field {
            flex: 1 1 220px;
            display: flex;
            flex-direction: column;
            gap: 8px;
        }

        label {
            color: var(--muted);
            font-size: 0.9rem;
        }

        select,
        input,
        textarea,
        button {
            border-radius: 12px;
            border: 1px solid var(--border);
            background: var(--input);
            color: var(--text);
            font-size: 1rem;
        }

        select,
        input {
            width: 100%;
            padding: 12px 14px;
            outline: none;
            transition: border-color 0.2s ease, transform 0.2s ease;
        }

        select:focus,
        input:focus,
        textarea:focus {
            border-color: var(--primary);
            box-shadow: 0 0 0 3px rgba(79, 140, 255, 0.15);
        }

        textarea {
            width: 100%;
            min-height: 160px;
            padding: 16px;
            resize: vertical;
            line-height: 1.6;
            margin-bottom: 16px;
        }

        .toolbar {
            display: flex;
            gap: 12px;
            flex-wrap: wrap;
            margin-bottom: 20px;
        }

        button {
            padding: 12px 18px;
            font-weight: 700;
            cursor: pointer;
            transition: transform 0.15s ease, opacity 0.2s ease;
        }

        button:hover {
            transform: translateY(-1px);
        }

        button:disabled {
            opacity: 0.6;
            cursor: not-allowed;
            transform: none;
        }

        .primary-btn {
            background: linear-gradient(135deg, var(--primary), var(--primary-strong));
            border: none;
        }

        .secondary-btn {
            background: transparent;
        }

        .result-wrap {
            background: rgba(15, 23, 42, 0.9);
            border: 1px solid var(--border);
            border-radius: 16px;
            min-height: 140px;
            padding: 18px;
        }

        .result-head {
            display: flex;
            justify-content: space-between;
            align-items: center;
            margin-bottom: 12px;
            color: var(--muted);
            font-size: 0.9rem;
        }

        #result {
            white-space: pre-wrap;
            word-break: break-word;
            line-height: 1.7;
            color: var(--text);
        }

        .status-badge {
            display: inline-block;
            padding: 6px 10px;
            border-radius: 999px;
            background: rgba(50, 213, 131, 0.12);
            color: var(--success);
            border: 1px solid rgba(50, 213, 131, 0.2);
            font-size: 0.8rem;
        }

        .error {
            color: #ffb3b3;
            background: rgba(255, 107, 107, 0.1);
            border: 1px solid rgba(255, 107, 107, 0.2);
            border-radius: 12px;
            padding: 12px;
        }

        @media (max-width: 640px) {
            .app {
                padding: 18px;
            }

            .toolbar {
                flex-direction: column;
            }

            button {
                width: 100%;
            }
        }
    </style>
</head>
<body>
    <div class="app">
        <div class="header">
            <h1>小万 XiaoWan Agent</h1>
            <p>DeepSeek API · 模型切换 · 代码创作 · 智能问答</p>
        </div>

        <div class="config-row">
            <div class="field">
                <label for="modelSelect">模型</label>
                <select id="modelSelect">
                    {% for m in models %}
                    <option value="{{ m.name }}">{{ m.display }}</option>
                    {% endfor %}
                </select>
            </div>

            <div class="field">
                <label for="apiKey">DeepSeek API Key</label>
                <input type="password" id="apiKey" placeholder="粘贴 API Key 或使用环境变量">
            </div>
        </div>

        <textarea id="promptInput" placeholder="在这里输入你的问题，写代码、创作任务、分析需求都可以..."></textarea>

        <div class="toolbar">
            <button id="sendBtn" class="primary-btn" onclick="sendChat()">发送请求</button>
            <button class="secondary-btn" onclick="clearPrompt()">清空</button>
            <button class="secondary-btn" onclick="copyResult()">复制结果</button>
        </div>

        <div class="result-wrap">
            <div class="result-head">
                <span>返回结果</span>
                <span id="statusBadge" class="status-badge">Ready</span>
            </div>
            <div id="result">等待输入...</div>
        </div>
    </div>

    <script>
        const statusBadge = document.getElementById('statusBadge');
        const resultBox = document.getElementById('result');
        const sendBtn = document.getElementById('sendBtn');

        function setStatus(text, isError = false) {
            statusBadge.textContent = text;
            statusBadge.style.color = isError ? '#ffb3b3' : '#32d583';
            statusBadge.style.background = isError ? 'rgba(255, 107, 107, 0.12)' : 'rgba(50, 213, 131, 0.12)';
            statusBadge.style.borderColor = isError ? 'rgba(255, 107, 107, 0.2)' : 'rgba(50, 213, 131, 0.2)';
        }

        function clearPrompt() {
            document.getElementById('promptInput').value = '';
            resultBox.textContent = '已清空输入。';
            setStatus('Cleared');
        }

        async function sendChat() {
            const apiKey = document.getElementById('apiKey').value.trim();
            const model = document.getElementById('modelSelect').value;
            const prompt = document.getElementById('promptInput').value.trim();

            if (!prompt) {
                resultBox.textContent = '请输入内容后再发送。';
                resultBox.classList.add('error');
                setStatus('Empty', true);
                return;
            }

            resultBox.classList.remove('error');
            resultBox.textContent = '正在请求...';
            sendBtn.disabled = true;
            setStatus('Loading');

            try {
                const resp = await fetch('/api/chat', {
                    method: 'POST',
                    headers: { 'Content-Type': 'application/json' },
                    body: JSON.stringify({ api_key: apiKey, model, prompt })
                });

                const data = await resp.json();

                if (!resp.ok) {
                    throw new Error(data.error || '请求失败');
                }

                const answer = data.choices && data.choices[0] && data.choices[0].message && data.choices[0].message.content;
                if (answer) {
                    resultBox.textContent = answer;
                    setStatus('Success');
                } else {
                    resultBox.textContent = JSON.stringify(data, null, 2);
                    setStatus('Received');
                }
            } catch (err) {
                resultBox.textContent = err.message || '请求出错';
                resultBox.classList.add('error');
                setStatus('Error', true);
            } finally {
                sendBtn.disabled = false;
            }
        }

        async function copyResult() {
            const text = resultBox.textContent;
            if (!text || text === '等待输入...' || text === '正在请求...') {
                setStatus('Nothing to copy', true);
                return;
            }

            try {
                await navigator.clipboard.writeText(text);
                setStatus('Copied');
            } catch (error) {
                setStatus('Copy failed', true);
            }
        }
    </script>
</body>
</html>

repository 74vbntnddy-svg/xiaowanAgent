from flask import Flask, render_template, request, jsonify
import os
import requests

app = Flask(__name__)

DEEPSEEK_API_URL = os.getenv("DEEPSEEK_API_URL", "https://api.deepseek.com/v1/chat/completions")
MODEL_LIST = [
    {"name": "deepseek-chat", "display": "DeepSeek Chat 通用对话"},
    {"name": "deepseek-coder", "display": "DeepSeek Coder 代码模式"},
    {"name": "deepseek-reasoner", "display": "DeepSeek Reasoner 推理模式"},
]


@app.route('/')
def index():
    return render_template("index.html", models=MODEL_LIST)


@app.route('/health')
def health():
    return jsonify({"status": "ok"}), 200


@app.route('/api/chat', methods=["POST"])
def chat():
    if not request.is_json:
        return jsonify({"error": "Request body must be JSON."}), 400

    data = request.get_json(silent=True) or {}
    api_key = (data.get("api_key") or os.getenv("DEEPSEEK_API_KEY") or "").strip()
    model_name = (data.get("model") or "deepseek-chat").strip()
    prompt = (data.get("prompt") or "").strip()

    if not api_key:
        return jsonify({"error": "DeepSeek API Key is required. Add it in the page or set DEEPSEEK_API_KEY."}), 400

    if not prompt:
        return jsonify({"error": "Prompt cannot be empty."}), 400

    allowed_models = {model["name"] for model in MODEL_LIST}
    if model_name not in allowed_models:
        return jsonify({"error": f"Unsupported model: {model_name}"}), 400

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }
    payload = {
        "model": model_name,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.7,
    }

    try:
        resp = requests.post(DEEPSEEK_API_URL, headers=headers, json=payload, timeout=60)
        result = resp.json()

        if resp.status_code >= 400:
            message = result.get("error", {}).get("message") or result.get("message") or "API request failed."
            return jsonify({"error": message}), resp.status_code

        return jsonify(result)
    except requests.exceptions.RequestException as exc:
        return jsonify({"error": f"Network error: {str(exc)}"}), 500


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
