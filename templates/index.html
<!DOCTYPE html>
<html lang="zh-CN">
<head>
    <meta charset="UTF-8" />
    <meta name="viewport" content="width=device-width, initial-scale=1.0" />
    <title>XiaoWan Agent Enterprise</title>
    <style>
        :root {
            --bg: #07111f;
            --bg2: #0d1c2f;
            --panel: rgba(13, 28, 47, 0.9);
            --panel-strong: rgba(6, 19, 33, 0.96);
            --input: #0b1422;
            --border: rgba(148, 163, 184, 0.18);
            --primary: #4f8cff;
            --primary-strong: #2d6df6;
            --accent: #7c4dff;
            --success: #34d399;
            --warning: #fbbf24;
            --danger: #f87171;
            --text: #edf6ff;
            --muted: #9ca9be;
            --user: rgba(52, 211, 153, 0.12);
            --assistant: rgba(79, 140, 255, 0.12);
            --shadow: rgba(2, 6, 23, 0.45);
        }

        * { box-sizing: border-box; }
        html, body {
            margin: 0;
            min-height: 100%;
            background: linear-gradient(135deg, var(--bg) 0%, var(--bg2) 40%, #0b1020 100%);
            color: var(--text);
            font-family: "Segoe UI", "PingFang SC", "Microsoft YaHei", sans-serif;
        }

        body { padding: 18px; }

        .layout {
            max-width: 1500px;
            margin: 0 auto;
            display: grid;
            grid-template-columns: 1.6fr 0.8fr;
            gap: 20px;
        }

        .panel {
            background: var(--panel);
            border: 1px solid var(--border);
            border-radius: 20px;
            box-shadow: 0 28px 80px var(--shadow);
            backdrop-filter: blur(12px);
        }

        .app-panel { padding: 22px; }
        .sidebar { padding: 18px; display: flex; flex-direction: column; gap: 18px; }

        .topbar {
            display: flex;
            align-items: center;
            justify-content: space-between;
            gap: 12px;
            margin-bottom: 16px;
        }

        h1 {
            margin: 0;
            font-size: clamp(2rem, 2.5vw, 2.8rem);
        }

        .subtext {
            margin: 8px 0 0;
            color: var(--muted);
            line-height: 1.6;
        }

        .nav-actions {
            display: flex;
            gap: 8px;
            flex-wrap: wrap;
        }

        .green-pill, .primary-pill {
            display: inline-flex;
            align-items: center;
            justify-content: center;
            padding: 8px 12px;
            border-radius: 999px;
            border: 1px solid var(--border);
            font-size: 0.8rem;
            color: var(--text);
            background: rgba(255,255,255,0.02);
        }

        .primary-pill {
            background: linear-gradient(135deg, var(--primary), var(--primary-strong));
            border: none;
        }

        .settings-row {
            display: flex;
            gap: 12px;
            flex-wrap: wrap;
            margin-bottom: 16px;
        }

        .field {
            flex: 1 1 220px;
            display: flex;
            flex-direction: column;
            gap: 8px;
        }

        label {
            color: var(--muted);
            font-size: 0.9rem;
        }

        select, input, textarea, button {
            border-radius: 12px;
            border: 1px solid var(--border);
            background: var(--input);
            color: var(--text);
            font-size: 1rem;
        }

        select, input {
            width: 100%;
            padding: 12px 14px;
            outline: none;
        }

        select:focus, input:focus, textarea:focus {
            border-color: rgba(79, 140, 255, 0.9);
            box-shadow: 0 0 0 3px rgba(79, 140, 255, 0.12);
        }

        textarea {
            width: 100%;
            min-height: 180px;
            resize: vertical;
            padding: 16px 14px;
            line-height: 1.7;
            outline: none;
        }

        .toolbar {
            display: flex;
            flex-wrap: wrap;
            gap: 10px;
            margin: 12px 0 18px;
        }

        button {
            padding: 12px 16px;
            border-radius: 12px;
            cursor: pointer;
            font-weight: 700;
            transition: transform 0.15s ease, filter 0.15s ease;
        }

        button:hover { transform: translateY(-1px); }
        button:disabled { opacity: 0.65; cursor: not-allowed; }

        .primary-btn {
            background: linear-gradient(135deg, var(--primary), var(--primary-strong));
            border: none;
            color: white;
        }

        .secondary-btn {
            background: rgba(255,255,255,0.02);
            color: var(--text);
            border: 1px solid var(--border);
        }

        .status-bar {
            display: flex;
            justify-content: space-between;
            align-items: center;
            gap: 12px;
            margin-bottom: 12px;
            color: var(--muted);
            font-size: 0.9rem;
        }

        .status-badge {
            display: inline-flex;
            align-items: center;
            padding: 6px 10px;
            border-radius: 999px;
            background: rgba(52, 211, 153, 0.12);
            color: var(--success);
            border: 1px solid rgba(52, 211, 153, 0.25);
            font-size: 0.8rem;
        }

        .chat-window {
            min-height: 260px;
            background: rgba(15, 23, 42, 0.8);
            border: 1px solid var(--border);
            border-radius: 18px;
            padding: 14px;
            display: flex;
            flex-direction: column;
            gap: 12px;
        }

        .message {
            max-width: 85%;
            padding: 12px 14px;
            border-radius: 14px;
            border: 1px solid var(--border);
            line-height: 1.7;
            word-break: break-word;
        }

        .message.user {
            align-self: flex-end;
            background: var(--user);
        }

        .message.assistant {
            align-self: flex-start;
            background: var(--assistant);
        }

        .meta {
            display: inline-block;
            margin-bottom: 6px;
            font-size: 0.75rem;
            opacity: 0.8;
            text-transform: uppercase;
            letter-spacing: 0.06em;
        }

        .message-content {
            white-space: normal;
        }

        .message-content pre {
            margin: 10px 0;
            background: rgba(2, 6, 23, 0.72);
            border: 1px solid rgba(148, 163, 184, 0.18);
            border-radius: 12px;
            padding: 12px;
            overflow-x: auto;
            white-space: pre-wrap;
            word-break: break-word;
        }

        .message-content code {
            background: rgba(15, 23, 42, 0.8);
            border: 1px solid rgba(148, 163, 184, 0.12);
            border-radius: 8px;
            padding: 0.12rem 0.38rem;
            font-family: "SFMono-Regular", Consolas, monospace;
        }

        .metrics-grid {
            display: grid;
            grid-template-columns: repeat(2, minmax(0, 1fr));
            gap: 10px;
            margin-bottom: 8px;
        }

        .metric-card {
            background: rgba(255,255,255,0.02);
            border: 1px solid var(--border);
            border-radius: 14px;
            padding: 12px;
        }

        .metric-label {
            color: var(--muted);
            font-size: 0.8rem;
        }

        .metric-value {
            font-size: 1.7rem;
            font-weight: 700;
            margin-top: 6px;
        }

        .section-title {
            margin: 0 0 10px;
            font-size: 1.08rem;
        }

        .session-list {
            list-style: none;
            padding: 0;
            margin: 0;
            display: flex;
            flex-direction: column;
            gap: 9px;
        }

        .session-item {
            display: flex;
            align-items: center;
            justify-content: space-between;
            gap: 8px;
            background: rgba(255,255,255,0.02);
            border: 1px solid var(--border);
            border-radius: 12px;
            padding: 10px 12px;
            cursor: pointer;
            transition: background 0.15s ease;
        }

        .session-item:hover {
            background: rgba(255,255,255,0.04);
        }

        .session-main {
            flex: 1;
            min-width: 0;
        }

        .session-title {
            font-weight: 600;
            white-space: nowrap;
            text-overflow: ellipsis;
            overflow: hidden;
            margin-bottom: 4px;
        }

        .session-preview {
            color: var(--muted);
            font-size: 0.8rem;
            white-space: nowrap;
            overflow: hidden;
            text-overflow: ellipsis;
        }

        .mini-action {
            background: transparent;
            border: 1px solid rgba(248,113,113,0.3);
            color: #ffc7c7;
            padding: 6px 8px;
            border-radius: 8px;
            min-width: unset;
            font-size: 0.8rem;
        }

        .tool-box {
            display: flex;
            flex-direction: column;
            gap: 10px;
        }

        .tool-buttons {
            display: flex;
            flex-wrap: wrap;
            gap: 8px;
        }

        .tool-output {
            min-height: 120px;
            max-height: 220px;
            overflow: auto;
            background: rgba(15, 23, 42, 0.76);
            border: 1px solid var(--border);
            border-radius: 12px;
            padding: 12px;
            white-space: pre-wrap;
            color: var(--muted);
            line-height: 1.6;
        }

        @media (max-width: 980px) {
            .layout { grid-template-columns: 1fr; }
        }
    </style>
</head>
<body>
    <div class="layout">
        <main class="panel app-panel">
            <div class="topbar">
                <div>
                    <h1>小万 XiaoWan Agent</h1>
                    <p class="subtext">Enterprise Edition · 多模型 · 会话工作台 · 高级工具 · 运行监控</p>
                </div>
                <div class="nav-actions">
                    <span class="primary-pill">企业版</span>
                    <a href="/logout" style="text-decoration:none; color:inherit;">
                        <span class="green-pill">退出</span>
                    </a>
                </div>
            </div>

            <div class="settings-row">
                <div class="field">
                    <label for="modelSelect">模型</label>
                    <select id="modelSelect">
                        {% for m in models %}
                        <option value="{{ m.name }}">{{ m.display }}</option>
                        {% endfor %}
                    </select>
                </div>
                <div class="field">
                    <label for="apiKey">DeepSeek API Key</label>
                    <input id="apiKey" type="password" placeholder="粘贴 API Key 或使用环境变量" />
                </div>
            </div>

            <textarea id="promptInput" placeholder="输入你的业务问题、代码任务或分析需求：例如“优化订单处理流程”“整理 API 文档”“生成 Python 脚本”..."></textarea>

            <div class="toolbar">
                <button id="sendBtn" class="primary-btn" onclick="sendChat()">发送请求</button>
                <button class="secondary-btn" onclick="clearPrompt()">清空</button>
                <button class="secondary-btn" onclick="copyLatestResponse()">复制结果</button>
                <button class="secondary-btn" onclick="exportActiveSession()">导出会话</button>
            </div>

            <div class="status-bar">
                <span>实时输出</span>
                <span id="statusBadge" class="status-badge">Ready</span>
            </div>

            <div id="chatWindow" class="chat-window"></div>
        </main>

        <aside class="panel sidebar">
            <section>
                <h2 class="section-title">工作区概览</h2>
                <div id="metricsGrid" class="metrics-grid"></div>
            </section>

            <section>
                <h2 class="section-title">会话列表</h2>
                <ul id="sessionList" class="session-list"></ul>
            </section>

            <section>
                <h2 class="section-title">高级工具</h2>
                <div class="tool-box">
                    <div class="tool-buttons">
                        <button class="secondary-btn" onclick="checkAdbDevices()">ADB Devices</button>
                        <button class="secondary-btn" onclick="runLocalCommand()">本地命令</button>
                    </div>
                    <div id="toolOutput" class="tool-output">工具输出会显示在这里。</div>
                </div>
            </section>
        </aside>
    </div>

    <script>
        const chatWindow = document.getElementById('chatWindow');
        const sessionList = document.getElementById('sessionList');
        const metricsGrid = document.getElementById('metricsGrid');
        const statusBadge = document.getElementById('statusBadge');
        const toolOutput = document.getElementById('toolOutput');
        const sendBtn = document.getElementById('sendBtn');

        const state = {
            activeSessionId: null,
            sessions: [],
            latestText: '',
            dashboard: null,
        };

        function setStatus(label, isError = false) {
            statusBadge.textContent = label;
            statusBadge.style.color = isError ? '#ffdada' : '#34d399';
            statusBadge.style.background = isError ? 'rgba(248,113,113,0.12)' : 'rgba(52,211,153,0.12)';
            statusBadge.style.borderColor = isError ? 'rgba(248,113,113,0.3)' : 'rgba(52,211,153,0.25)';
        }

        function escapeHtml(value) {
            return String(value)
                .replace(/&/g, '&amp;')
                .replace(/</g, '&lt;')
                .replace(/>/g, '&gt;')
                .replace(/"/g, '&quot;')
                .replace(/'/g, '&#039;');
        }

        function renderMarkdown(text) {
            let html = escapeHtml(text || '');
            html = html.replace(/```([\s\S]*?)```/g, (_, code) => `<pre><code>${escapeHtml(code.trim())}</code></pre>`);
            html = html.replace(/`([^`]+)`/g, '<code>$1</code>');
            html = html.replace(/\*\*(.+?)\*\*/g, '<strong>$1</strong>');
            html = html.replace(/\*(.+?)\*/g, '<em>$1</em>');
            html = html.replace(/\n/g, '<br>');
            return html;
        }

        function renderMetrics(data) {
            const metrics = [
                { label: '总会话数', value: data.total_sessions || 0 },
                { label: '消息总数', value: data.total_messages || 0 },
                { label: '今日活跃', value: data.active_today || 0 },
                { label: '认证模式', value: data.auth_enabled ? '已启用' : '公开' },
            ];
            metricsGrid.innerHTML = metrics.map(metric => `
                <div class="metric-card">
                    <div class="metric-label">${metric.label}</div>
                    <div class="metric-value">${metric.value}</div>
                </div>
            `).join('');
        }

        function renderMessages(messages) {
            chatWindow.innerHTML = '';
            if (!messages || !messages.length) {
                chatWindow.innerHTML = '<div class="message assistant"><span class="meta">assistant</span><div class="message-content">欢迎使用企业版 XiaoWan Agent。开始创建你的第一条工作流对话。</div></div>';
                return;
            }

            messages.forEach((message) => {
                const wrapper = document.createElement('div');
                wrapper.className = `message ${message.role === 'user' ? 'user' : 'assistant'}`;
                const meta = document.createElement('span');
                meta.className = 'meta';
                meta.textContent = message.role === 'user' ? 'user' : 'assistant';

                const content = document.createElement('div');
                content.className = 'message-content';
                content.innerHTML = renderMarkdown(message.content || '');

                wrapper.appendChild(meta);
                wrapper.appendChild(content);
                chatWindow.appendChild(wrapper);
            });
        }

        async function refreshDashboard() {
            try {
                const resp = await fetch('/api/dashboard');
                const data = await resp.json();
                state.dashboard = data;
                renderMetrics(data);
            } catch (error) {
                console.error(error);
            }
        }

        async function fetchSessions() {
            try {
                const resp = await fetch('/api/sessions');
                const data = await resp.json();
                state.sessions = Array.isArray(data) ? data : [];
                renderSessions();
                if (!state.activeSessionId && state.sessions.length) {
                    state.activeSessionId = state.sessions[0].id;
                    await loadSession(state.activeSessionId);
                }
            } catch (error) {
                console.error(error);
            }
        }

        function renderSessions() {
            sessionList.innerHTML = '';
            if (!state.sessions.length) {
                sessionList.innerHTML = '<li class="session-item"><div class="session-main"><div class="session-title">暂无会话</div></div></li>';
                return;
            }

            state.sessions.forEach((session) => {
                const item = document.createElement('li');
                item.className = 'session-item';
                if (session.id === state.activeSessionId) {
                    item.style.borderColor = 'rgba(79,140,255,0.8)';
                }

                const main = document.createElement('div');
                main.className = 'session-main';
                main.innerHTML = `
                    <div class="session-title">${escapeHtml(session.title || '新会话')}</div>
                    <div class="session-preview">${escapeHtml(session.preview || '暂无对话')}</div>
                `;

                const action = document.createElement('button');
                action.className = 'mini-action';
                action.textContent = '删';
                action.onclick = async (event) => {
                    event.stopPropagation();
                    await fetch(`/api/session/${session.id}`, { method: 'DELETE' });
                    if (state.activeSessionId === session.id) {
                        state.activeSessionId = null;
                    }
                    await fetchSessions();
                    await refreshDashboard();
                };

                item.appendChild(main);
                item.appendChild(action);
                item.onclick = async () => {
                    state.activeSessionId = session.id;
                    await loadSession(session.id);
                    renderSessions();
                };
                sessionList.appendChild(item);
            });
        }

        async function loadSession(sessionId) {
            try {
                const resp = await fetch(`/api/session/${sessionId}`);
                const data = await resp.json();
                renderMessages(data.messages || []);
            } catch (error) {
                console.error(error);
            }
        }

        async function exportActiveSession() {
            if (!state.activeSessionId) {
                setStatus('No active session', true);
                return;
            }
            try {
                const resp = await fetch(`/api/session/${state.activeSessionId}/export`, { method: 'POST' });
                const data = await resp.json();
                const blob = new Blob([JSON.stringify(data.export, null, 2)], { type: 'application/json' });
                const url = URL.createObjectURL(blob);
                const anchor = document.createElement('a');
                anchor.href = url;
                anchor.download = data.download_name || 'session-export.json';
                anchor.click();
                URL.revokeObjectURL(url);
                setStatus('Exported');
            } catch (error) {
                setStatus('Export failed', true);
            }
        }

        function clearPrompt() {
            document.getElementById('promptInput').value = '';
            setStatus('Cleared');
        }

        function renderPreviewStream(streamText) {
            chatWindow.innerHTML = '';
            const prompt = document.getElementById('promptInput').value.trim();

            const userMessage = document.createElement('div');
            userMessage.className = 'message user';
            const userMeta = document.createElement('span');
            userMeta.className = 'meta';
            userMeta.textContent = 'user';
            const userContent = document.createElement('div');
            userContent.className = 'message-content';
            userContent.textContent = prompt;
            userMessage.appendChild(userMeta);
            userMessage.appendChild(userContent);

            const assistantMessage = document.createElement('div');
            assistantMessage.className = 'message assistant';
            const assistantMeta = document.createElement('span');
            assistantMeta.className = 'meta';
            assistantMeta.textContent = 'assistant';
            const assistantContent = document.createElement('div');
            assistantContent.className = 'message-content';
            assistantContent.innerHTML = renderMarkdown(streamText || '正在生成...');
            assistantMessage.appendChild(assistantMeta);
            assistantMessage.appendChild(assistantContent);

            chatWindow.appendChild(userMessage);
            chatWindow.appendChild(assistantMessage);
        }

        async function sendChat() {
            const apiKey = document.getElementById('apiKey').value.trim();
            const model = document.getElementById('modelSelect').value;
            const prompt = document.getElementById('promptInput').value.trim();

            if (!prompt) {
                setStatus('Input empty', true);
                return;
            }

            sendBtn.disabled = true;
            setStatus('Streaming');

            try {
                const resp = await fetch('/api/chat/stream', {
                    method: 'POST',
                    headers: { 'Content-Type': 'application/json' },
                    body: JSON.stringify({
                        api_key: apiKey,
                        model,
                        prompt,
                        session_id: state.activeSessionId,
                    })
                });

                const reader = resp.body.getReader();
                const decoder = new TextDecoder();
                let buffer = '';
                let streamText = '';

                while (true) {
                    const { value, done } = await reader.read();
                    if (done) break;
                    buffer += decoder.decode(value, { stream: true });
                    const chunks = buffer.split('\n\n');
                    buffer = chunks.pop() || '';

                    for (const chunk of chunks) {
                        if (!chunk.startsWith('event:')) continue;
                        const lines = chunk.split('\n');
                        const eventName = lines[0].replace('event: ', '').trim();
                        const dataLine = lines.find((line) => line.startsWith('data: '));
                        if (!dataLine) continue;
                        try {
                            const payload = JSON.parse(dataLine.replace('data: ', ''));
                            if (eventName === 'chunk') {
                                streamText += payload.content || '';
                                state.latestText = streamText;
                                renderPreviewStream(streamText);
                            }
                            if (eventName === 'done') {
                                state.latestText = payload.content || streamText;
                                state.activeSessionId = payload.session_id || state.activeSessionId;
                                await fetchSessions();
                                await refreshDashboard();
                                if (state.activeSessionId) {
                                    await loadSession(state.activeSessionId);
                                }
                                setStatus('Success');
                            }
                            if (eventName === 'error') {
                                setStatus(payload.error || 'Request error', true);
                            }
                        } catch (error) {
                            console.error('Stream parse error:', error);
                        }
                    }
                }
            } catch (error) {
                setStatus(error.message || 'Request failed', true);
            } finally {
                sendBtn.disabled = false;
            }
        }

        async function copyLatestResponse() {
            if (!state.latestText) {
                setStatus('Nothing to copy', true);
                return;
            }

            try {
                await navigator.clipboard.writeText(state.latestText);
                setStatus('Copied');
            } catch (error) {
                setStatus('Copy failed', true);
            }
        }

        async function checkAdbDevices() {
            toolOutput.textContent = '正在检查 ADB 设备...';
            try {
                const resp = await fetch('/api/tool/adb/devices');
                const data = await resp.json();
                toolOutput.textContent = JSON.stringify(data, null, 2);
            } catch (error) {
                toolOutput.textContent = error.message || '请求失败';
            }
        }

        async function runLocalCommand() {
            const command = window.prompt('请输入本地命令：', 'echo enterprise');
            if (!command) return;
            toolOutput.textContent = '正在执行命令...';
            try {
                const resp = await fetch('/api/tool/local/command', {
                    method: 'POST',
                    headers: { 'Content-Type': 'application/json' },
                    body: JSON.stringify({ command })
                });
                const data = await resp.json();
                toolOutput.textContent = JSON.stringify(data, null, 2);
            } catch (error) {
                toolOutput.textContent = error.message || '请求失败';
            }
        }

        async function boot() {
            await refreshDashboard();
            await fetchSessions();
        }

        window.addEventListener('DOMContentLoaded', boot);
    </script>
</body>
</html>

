MODEL_LIST = [
    {"name": "deepseek-chat", "display": "DeepSeek Chat 通用对话"},
    {"name": "deepseek-coder", "display": "DeepSeek Coder 代码模式"},
    {"name": "deepseek-reasoner", "display": "DeepSeek Reasoner 推理模式"},
