    "You are XiaoWan Agent Enterprise, a professional AI assistant for business workflows. "
    "Provide structured, accurate, and actionable answers. Use clear sections, bullet points, and code blocks when useful."
)


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(path: Path, default):
    if not path.exists():
        return default
    try:
        with path.open("r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, type(default)) else default
    except (json.JSONDecodeError, OSError):
        return default


def write_json(path: Path, data):
    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def log_event(event: str, detail: str = ""):
    entry = {
        "timestamp": utc_now(),
        "event": event,
        "detail": detail,
    }
    try:
        with AUDIT_FILE.open("a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def load_sessions() -> dict:
    data = read_json(SESSIONS_FILE, {})
    return data if isinstance(data, dict) else {}


def save_sessions(data: dict):
    write_json(SESSIONS_FILE, data)


SESSIONS = load_sessions()


def configured_auth() -> tuple[str, str] | None:
    username = (os.getenv("ADMIN_USERNAME") or "").strip()
    password = (os.getenv("ADMIN_PASSWORD") or "").strip()
    if username and password:
        return username, password
    return None


def is_logged_in() -> bool:
    return bool(session.get("authed"))


@app.before_request
def enforce_auth():
    if request.path in {"/login", "/logout"}:
        return None
    if request.path.startswith("/static/"):
        return None
    auth = configured_auth()
    if not auth:
        return None
    if not is_logged_in():
        if request.path.startswith("/api/"):
            return jsonify({"error": "Authentication required."}), 401
        return redirect(url_for("login_page"))


@app.route("/login", methods=["GET", "POST"])
def login_page():
    auth = configured_auth()
    if not auth:
        return redirect(url_for("index"))

    if request.method == "POST":
        username = (request.form.get("username") or "").strip()
        password = (request.form.get("password") or "").strip()
        if username == auth[0] and password == auth[1]:
            session["authed"] = True
            session["username"] = username
            log_event("login", username)
            return redirect(url_for("index"))
        return render_template("login.html", error="用户名或密码不正确")

    if is_logged_in():
        return redirect(url_for("index"))
    return render_template("login.html")


@app.route("/logout")
def logout():
    session.clear()
    return redirect(url_for("login_page"))


def get_session_or_create(session_id: str | None) -> str:
    if not session_id:
        session_id = f"session-{int(datetime.now(timezone.utc).timestamp() * 1000)}"
    SESSIONS.setdefault(
        session_id,
        {
            "id": session_id,
            "title": "新会话",
            "created_at": utc_now(),
            "updated_at": utc_now(),
            "messages": [],
        },
    )
    SESSIONS[session_id]["updated_at"] = utc_now()
    save_sessions(SESSIONS)
    return session_id


def add_message(session_id: str, role: str, content: str):
    session_data = SESSIONS.setdefault(
        session_id,
        {
            "id": session_id,
            "title": "新会话",
            "created_at": utc_now(),
            "updated_at": utc_now(),
            "messages": [],
        },
    )
    session_data["messages"].append({
        "role": role,
        "content": content,
        "timestamp": utc_now(),
    })
    if role == "user" and (not session_data.get("title") or session_data.get("title") == "新会话"):
        title = (content or "未命名会话").strip()
        session_data["title"] = title[:32] or "新会话"
    session_data["updated_at"] = utc_now()
    save_sessions(SESSIONS)


def build_messages(session_id: str | None, prompt: str):
    session_id = get_session_or_create(session_id)
    session_data = SESSIONS.get(session_id, {})
    messages = [{"role": "system", "content": DEFAULT_SYSTEM_PROMPT}]
    for item in session_data.get("messages", []):
        role = item.get("role")
        if role in {"user", "assistant"}:
            messages.append({"role": role, "content": item.get("content", "")})
    messages.append({"role": "user", "content": prompt})
    return session_id, messages


def dashboard_summary():
    total_sessions = len(SESSIONS)
    total_messages = sum(len(session.get("messages", [])) for session in SESSIONS.values())
    active_today = 0
    now = datetime.now(timezone.utc)
    for session_data in SESSIONS.values():
        updated_at = session_data.get("updated_at")
        if not updated_at:
            continue
        try:
            dt = datetime.strptime(updated_at, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
            if (now - dt).total_seconds() <= 86400:
                active_today += 1
        except ValueError:
            pass
    return {
        "total_sessions": total_sessions,
        "total_messages": total_messages,
        "active_today": active_today,
        "auth_enabled": bool(configured_auth()),
        "model_count": len(MODEL_LIST),
    }


