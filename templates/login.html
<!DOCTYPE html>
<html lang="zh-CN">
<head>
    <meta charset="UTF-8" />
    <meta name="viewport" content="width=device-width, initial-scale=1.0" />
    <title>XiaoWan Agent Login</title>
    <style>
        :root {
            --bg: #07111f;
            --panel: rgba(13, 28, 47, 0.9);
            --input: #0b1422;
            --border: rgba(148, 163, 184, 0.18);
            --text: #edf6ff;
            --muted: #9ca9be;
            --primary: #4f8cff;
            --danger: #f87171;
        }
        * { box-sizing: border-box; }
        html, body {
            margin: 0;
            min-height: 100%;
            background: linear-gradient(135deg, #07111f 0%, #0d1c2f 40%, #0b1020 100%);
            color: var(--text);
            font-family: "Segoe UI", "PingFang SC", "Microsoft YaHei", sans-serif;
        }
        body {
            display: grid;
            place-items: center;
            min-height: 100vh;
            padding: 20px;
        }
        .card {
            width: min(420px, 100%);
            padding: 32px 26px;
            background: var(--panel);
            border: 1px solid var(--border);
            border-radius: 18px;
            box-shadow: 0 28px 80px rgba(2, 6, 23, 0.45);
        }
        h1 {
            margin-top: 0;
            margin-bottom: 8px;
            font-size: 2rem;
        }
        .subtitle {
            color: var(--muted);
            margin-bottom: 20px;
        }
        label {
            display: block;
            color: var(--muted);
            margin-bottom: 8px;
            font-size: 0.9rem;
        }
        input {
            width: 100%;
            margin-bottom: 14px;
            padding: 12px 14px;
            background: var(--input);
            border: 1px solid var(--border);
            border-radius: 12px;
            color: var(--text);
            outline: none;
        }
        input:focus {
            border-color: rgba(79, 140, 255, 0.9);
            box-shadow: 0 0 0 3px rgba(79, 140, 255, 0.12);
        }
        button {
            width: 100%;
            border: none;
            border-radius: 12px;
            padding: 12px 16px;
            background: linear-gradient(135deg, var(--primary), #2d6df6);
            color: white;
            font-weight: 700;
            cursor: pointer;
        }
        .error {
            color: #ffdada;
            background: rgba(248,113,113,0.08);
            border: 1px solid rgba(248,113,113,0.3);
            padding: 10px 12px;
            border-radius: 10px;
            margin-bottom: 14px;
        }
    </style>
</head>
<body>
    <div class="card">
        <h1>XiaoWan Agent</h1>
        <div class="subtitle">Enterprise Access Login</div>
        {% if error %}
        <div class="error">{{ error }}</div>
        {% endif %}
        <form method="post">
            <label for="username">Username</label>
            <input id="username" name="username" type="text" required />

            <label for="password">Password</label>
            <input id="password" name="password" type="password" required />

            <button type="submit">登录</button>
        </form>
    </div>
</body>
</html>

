<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>XiaoWan Agent Enterprise</title>
    <style>
        :root {
            --bg: #07111f;
            --bg2: #0d1c2f;
            --panel: rgba(13, 28, 47, 0.9);
            --input: #0b1422;
            --border: rgba(148, 163, 184, 0.18);
            --primary: #4f8cff;
            --primary-strong: #2d6df6;
            --success: #34d399;
            --text: #edf6ff;
            --muted: #9ca9be;
            --user: rgba(52, 211, 153, 0.12);
            --assistant: rgba(79, 140, 255, 0.12);
            --shadow: rgba(2, 6, 23, 0.45);
        }

        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            min-height: 100%;
            background: linear-gradient(135deg, var(--bg) 0%, var(--bg2) 40%, #0b1020 100%);
            color: var(--text);
            font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
        }

        body { padding: 18px; }

        .layout {
            max-width: 1500px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.6fr 0.8fr;
            gap: 20px;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 20px;
            box-shadow: 0 28px 80px var(--shadow);
            backdrop-filter: blur(12px);
        }

        .app-panel { padding: 22px; }
        .sidebar { padding: 18px; display: flex; flex-direction: column; gap: 18px; }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        h1 {
            margin: 0;
            font-size: clamp(2rem, 2.5vw, 2.8rem);
        }

        .subtext {
            margin: 8px 0 0;
            color: var(--muted);
            line-height: 1.6;
        }

        .nav-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .green-pill, .primary-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid var(--border);
            font-size: 0.8rem;
            color: var(--text);
            background: rgba(255,255,255,0.02);
        }

        .primary-pill {
            background: linear-gradient(135deg, var(--primary), var(--primary-strong));
            border: none;
        }

        .settings-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .field {
            flex: 1 1 220px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        label {
            color: var(--muted);
            font-size: 0.9rem;
        }

        select, input, textarea, button {
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--input);
            color: var(--text);
            font-size: 1rem;
        }

        select, input {
            width: 100%;
            padding: 12px 14px;
            outline: none;
        }

        select:focus, input:focus, textarea:focus {
            border-color: rgba(79, 140, 255, 0.9);
            box-shadow: 0 0 0 3px rgba(79, 140, 255, 0.12);
        }

        textarea {
            width: 100%;
            min-height: 180px;
            resize: vertical;
            padding: 16px 14px;
            line-height: 1.7;
            outline: none;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 12px 0 18px;
        }

        button {
            padding: 12px 16px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 700;
            transition: transform 0.15s ease, filter 0.15s ease;
        }

        button:hover { transform: translateY(-1px); }
        button:disabled { opacity: 0.65; cursor: not-allowed; }

        .primary-btn {
            background: linear-gradient(135deg, var(--primary), var(--primary-strong));
            border: none;
            color: white;
        }

        .secondary-btn {
            background: rgba(255,255,255,0.02);
            color: var(--text);
            border: 1px solid var(--border);
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            color: var(--muted);
            font-size: 0.9rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(52, 211, 153, 0.12);
            color: var(--success);
            border: 1px solid rgba(52, 211, 153, 0.25);
            font-size: 0.8rem;
        }

        .chat-window {
            min-height: 260px;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .message {
            max-width: 85%;
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid var(--border);
            line-height: 1.7;
            word-break: break-word;
        }

        .message.user {
            align-self: flex-end;
            background: var(--user);
        }

        .message.assistant {
            align-self: flex-start;
            background: var(--assistant);
        }

        .meta {
            display: inline-block;
            margin-bottom: 6px;
            font-size: 0.75rem;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .message-content {
            white-space: normal;
        }

        .message-content pre {
            margin: 10px 0;
            background: rgba(2, 6, 23, 0.72);
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 12px;
            padding: 12px;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .message-content code {
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(148, 163, 184, 0.12);
            border-radius: 8px;
            padding: 0.12rem 0.38rem;
            font-family: "SFMono-Regular", Consolas, monospace;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 8px;
        }

        .metric-card {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px;
        }

        .metric-label {
            color: var(--muted);
            font-size: 0.8rem;
        }

        .metric-value {
            font-size: 1.7rem;
            font-weight: 700;
            margin-top: 6px;
        }

        .section-title {
            margin: 0 0 10px;
            font-size: 1.08rem;
        }

        .session-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .session-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px 12px;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .session-item:hover {
            background: rgba(255,255,255,0.04);
        }

        .session-main {
            flex: 1;
            min-width: 0;
        }

        .session-title {
            font-weight: 600;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
            margin-bottom: 4px;
        }

        .session-preview {
            color: var(--muted);
            font-size: 0.8rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mini-action {
            background: transparent;
            border: 1px solid rgba(248,113,113,0.3);
            color: #ffc7c7;
            padding: 6px 8px;
            border-radius: 8px;
            min-width: unset;
            font-size: 0.8rem;
        }

        .tool-box {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tool-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tool-output {
            min-height: 120px;
            max-height: 220px;
            overflow: auto;
            background: rgba(15, 23, 42, 0.76);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px;
            white-space: pre-wrap;
            color: var(--muted);
            line-height: 1.6;
        }

        @media (max-width: 980px) {
            .layout { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="layout">
        <main class="panel app-panel">
            <div class="topbar">
                <div>
                    <h1>小万 XiaoWan Agent</h1>
                    <p class="subtext">Enterprise Edition · 多模型 · 会话工作台 · 高级工具 · 运行监控</p>
                </div>
                <div class="nav-actions">
                    <span class="primary-pill">企业版</span>
                    <a href="/logout" style="text-decoration:none; color:inherit;">
                        <span class="green-pill">退出</span>
                    </a>
                </div>
            </div>

            <div class="settings-row">
                <div class="field">
                    <label for="modelSelect">模型</label>
                    <select id="modelSelect">
                        {% for m in models %}
                        <option value="{{ m.name }}">{{ m.display }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label for="apiKey">DeepSeek API Key</label>
                    <input id="apiKey" type="password" placeholder="粘贴 API Key 或使用环境变量" />
                </div>
            </div>

            <textarea id="promptInput" placeholder="输入你的业务问题、代码任务或分析需求：例如“优化订单处理流程”“整理 API 文档”“生成 Python 脚本”..."></textarea>

            <div class="toolbar">
                <button id="sendBtn" class="primary-btn" onclick="sendChat()">发送请求</button>
                <button class="secondary-btn" onclick="clearPrompt()">清空</button>
                <button class="secondary-btn" onclick="copyLatestResponse()">复制结果</button>
                <button class="secondary-btn" onclick="exportActiveSession()">导出会话</button>
            </div>

            <div class="status-bar">
                <span>实时输出</span>
                <span id="statusBadge" class="status-badge">Ready</span>
            </div>

            <div id="chatWindow" class="chat-window"></div>
        </main>

        <aside class="panel sidebar">
            <section>
                <h2 class="section-title">工作区概览</h2>
                <div id="metricsGrid" class="metrics-grid"></div>
            </section>

            <section>
                <h2 class="section-title">会话列表</h2>
                <ul id="sessionList" class="session-list"></ul>
            </section>

            <section>
                <h2 class="section-title">高级工具</h2>
                <div class="tool-box">
                    <div class="tool-buttons">
                        <button class="secondary-btn" onclick="checkAdbDevices()">ADB Devices</button>
                        <button class="secondary-btn" onclick="runLocalCommand()">本地命令</button>
                    </div>
                    <div id="toolOutput" class="tool-output">工具输出会显示在这里。</div>
                </div>
            </section>
        </aside>
    </div>

    <script>
        const chatWindow = document.getElementById('chatWindow');
        const sessionList = document.getElementById('sessionList');
        const metricsGrid = document.getElementById('metricsGrid');
        const statusBadge = document.getElementById('statusBadge');
        const toolOutput = document.getElementById('toolOutput');
        const sendBtn = document.getElementById('sendBtn');

        const state = {
            activeSessionId: null,
            sessions: [],
            latestText: '',
            dashboard: null,
        };

        function setStatus(label, isError = false) {
            statusBadge.textContent = label;
            statusBadge.style.color = isError ? '#ffdada' : '#34d399';
            statusBadge.style.background = isError ? 'rgba(248,113,113,0.12)' : 'rgba(52,211,153,0.12)';
            statusBadge.style.borderColor = isError ? 'rgba(248,113,113,0.3)' : 'rgba(52,211,153,0.25)';
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderMarkdown(text) {
            let html = escapeHtml(text || '');
            html = html.replace(/```([\s\S]*?)```/g, (_, code) => `<pre><code>${escapeHtml(code.trim())}</code></pre>`);
            html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
            html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
            html = html.replace(/\n/g, '<br>');
            return html;
        }

        function renderMetrics(data) {
            const metrics = [
                { label: '总会话数', value: data.total_sessions || 0 },
                { label: '消息总数', value: data.total_messages || 0 },
                { label: '今日活跃', value: data.active_today || 0 },
                { label: '认证模式', value: data.auth_enabled ? '已启用' : '公开' },
            ];
            metricsGrid.innerHTML = metrics.map(metric => `
                <div class="metric-card">
                    <div class="metric-label">${metric.label}</div>
                    <div class="metric-value">${metric.value}</div>
                </div>
            `).join('');
        }

        function renderMessages(messages) {
            chatWindow.innerHTML = '';
            if (!messages || !messages.length) {
                chatWindow.innerHTML = '<div class="message assistant"><span class="meta">assistant</span><div class="message-content">欢迎使用企业版 XiaoWan Agent。开始创建你的第一条工作流对话。</div></div>';
                return;
            }

            messages.forEach((message) => {
                const wrapper = document.createElement('div');
                wrapper.className = `message ${message.role === 'user' ? 'user' : 'assistant'}`;
                const meta = document.createElement('span');
                meta.className = 'meta';
                meta.textContent = message.role === 'user' ? 'user' : 'assistant';

                const content = document.createElement('div');
                content.className = 'message-content';
                content.innerHTML = renderMarkdown(message.content || '');

                wrapper.appendChild(meta);
                wrapper.appendChild(content);
                chatWindow.appendChild(wrapper);
            });
        }

        async function refreshDashboard() {
            try {
                const resp = await fetch('/api/dashboard');
                const data = await resp.json();
                state.dashboard = data;
                renderMetrics(data);
            } catch (error) {
                console.error(error);
            }
        }

        async function fetchSessions() {
            try {
                const resp = await fetch('/api/sessions');
                const data = await resp.json();
                state.sessions = Array.isArray(data) ? data : [];
                renderSessions();
                if (!state.activeSessionId && state.sessions.length) {
                    state.activeSessionId = state.sessions[0].id;
                    await loadSession(state.activeSessionId);
                }
            } catch (error) {
                console.error(error);
            }
        }

        function renderSessions() {
            sessionList.innerHTML = '';
            if (!state.sessions.length) {
                sessionList.innerHTML = '<li class="session-item"><div class="session-main"><div class="session-title">暂无会话</div></div></li>';
                return;
            }

            state.sessions.forEach((session) => {
                const item = document.createElement('li');
                item.className = 'session-item';
                if (session.id === state.activeSessionId) {
                    item.style.borderColor = 'rgba(79,140,255,0.8)';
                }

                const main = document.createElement('div');
                main.className = 'session-main';
                main.innerHTML = `
                    <div class="session-title">${escapeHtml(session.title || '新会话')}</div>
                    <div class="session-preview">${escapeHtml(session.preview || '暂无对话')}</div>
                `;

                const action = document.createElement('button');
                action.className = 'mini-action';
                action.textContent = '删';
                action.onclick = async (event) => {
                    event.stopPropagation();
                    await fetch(`/api/session/${session.id}`, { method: 'DELETE' });
                    if (state.activeSessionId === session.id) {
                        state.activeSessionId = null;
                    }
                    await fetchSessions();
                    await refreshDashboard();
                };

                item.appendChild(main);
                item.appendChild(action);
                item.onclick = async () => {
                    state.activeSessionId = session.id;
                    await loadSession(session.id);
                    renderSessions();
                };
                sessionList.appendChild(item);
            });
        }

        async function loadSession(sessionId) {
            try {
                const resp = await fetch(`/api/session/${sessionId}`);
                const data = await resp.json();
                renderMessages(data.messages || []);
            } catch (error) {
                console.error(error);
            }
        }

        async function exportActiveSession() {
            if (!state.activeSessionId) {
                setStatus('No active session', true);
                return;
            }
            try {
                const resp = await fetch(`/api/session/${state.activeSessionId}/export`, { method: 'POST' });
                const data = await resp.json();
                const blob = new Blob([JSON.stringify(data.export, null, 2)], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const anchor = document.createElement('a');
                anchor.href = url;
                anchor.download = data.download_name || 'session-export.json';
                anchor.click();
                URL.revokeObjectURL(url);
                setStatus('Exported');
            } catch (error) {
                setStatus('Export failed', true);
            }
        }

        function clearPrompt() {
            document.getElementById('promptInput').value = '';
            setStatus('Cleared');
        }

        function renderPreviewStream(streamText) {
            chatWindow.innerHTML = '';
            const prompt = document.getElementById('promptInput').value.trim();

            const userMessage = document.createElement('div');
            userMessage.className = 'message user';
            const userMeta = document.createElement('span');
            userMeta.className = 'meta';
            userMeta.textContent = 'user';
            const userContent = document.createElement('div');
            userContent.className = 'message-content';
            userContent.textContent = prompt;
            userMessage.appendChild(userMeta);
            userMessage.appendChild(userContent);

            const assistantMessage = document.createElement('div');
            assistantMessage.className = 'message assistant';
            const assistantMeta = document.createElement('span');
            assistantMeta.className = 'meta';
            assistantMeta.textContent = 'assistant';
            const assistantContent = document.createElement('div');
            assistantContent.className = 'message-content';
            assistantContent.innerHTML = renderMarkdown(streamText || '正在生成...');
            assistantMessage.appendChild(assistantMeta);
            assistantMessage.appendChild(assistantContent);

            chatWindow.appendChild(userMessage);
            chatWindow.appendChild(assistantMessage);
        }

        async function sendChat() {
            const apiKey = document.getElementById('apiKey').value.trim();
            const model = document.getElementById('modelSelect').value;
            const prompt = document.getElementById('promptInput').value.trim();

            if (!prompt) {
                setStatus('Input empty', true);
                return;
            }

            sendBtn.disabled = true;
            setStatus('Streaming');

            try {
                const resp = await fetch('/api/chat/stream', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        api_key: apiKey,
                        model,
                        prompt,
                        session_id: state.activeSessionId,
                    })
                });

                const reader = resp.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let streamText = '';

                while (true) {
                    const { value, done } = await reader.read();
                    if (done) break;
                    buffer += decoder.decode(value, { stream: true });
                    const chunks = buffer.split('\n\n');
                    buffer = chunks.pop() || '';

                    for (const chunk of chunks) {
                        if (!chunk.startsWith('event:')) continue;
                        const lines = chunk.split('\n');
                        const eventName = lines[0].replace('event: ', '').trim();
                        const dataLine = lines.find((line) => line.startsWith('data: '));
                        if (!dataLine) continue;
                        try {
                            const payload = JSON.parse(dataLine.replace('data: ', ''));
                            if (eventName === 'chunk') {
                                streamText += payload.content || '';
                                state.latestText = streamText;
                                renderPreviewStream(streamText);
                            }
                            if (eventName === 'done') {
                                state.latestText = payload.content || streamText;
                                state.activeSessionId = payload.session_id || state.activeSessionId;
                                await fetchSessions();
                                await refreshDashboard();
                                if (state.activeSessionId) {
                                    await loadSession(state.activeSessionId);
                                }
                                setStatus('Success');
                            }
                            if (eventName === 'error') {
                                setStatus(payload.error || 'Request error', true);
                            }
                        } catch (error) {
                            console.error('Stream parse error:', error);
                        }
                    }
                }
            } catch (error) {
                setStatus(error.message || 'Request failed', true);
            } finally {
                sendBtn.disabled = false;
            }
        }

        async function copyLatestResponse() {
            if (!state.latestText) {
                setStatus('Nothing to copy', true);
                return;
            }

            try {
                await navigator.clipboard.writeText(state.latestText);
                setStatus('Copied');
            } catch (error) {
                setStatus('Copy failed', true);
            }
        }

        async function checkAdbDevices() {
            toolOutput.textContent = '正在检查 ADB 设备...';
            try {
                const resp = await fetch('/api/tool/adb/devices');
                const data = await resp.json();
                toolOutput.textContent = JSON.stringify(data, null, 2);
            } catch (error) {
                toolOutput.textContent = error.message || '请求失败';
            }
        }

        async function runLocalCommand() {
            const command = window.prompt('请输入本地命令：', 'echo enterprise');
            if (!command) return;
            toolOutput.textContent = '正在执行命令...';
            try {
                const resp = await fetch('/api/tool/local/command', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command })
                });
                const data = await resp.json();
                toolOutput.textContent = JSON.stringify(data, null, 2);
            } catch (error) {
                toolOutput.textContent = error.message || '请求失败';
            }
        }

        async function boot() {
            await refreshDashboard();
            await fetchSessions();
        }

        window.addEventListener('DOMContentLoaded', boot);
    </script>
</body>
</html>

